# Copy to .env and fill in. Never commit .env (it is gitignored).

# --- Mistral (embedding + generation + RAGAS judge) ---
MISTRAL_API_KEY=

# --- Qdrant Cloud (vector store) ---
QDRANT_URL=
QDRANT_API_KEY=

# --- Cohere second-stage reranking ---
# Keep RERANK_MODE=off for vector-only operation. Use a Production key for a
# deployed service; trial keys are intended for evaluation and limited to 10 rpm.
RERANK_MODE=off
RERANK_MODEL=rerank-v4.0-pro
RERANK_TIMEOUT_S=3.0
COHERE_API_KEY=

# --- LangSmith (tracing) ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aiact-rag
